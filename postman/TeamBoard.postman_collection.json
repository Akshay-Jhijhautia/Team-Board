						"exec": [
							"pm.test(\"Knowledge base query succeeds\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"pm.expect(response.search).to.eql(\"JWT\");",
							"pm.expect(response.count).to.be.above(0);",
							"pm.expect(response.results).to.be.an(\"array\");",
							"pm.expect(response.results.length).to.eql(response.count);"
